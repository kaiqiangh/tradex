{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IpcSchema",
  "description": "Exported to JSON Schema and TypeScript, and used for renderer runtime validation.",
  "type": "object",
  "properties": {
    "accountMutation": {
      "$ref": "#/$defs/AccountMutation"
    },
    "accountQuery": {
      "$ref": "#/$defs/AccountQuery"
    },
    "aggregate": {
      "$ref": "#/$defs/Aggregate"
    },
    "command": {
      "$ref": "#/$defs/CommandEnvelope"
    },
    "empty": {
      "$ref": "#/$defs/EmptyPayload"
    },
    "event": {
      "$ref": "#/$defs/DomainEvent"
    },
    "providerConnect": {
      "$ref": "#/$defs/Connect"
    },
    "providerSelection": {
      "$ref": "#/$defs/ProviderSelection"
    },
    "result": {
      "$ref": "#/$defs/ResultEnvelope"
    },
    "subscribe": {
      "$ref": "#/$defs/Subscribe"
    },
    "workspaceOpen": {
      "$ref": "#/$defs/OpenWorkspace"
    },
    "workspaceQuery": {
      "$ref": "#/$defs/WorkspaceQuery"
    }
  },
  "required": [
    "command",
    "result",
    "event",
    "workspaceOpen",
    "aggregate",
    "subscribe",
    "empty",
    "providerSelection",
    "workspaceQuery",
    "accountQuery",
    "accountMutation",
    "providerConnect"
  ],
  "$defs": {
    "AccountConnection": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1
        },
        "connectionState": {
          "$ref": "#/$defs/ConnectionState"
        },
        "createdAt": {
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountData"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "type": "string"
        },
        "health": {
          "$ref": "#/$defs/AccountHealth"
        },
        "label": {
          "type": "string"
        },
        "lastSuccessfulSync": {
          "type": [
            "string",
            "null"
          ]
        },
        "permissions": {
          "$ref": "#/$defs/PermissionReview"
        },
        "providerId": {
          "type": "string"
        },
        "stateVersion": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "connectionId",
        "workspaceId",
        "providerId",
        "environment",
        "label",
        "createdAt",
        "updatedAt",
        "stateVersion",
        "connectionState",
        "health",
        "permissions"
      ]
    },
    "AccountData": {
      "type": "object",
      "properties": {
        "accountType": {
          "type": "string"
        },
        "balances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Balance"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "openOrders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenOrder"
          }
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Position"
          }
        },
        "remoteAccountId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "remoteAccountId",
        "accountType",
        "balances",
        "positions",
        "openOrders",
        "capabilities",
        "limitations"
      ]
    },
    "AccountHealth": {
      "type": "object",
      "properties": {
        "arming": {
          "type": "string"
        },
        "authentication": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        },
        "credential": {
          "type": "string"
        },
        "executionEligibility": {
          "type": "string"
        },
        "privateStream": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "reconciliation": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "connection",
        "authentication",
        "credential",
        "privateStream",
        "reconciliation",
        "executionEligibility",
        "arming",
        "reason"
      ]
    },
    "AccountMutation": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "expectedStateVersion": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "connectionId",
        "expectedStateVersion"
      ]
    },
    "AccountQuery": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "connectionId"
      ]
    },
    "Accounts": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountConnection"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "accounts"
      ]
    },
    "Aggregate": {
      "type": "object",
      "properties": {
        "aggregateId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "aggregateType": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "aggregateType",
        "aggregateId"
      ]
    },
    "Balance": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string"
        },
        "available": {
          "type": "string"
        },
        "total": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "asset",
        "available"
      ]
    },
    "CommandEnvelope": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "payload": true,
        "requestId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 1,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "schemaVersion",
        "command",
        "payload"
      ]
    },
    "Connect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "environment": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "providerId": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "test"
            },
            "workspaceId": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "step",
            "workspaceId",
            "providerId",
            "environment",
            "label"
          ]
        },
        {
          "type": "object",
          "properties": {
            "acknowledgeUnverified": {
              "type": "boolean"
            },
            "connectionId": {
              "type": "string"
            },
            "expectedStateVersion": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "confirm"
            },
            "workspaceId": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "step",
            "workspaceId",
            "connectionId",
            "expectedStateVersion",
            "acknowledgeUnverified"
          ]
        }
      ]
    },
    "ConnectionState": {
      "type": "string",
      "enum": [
        "CONNECTING",
        "REVIEW_REQUIRED",
        "CONNECTED",
        "FAILED",
        "DISCONNECTED"
      ]
    },
    "DomainEvent": {
      "type": "object",
      "properties": {
        "aggregateId": {
          "type": "string",
          "minLength": 1
        },
        "aggregateType": {
          "type": "string",
          "enum": [
            "workspace",
            "account"
          ]
        },
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "eventType": {
          "type": "string",
          "enum": [
            "workspace.opened",
            "account.health.changed"
          ]
        },
        "occurredAt": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/DomainProjection"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 1,
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventType",
        "schemaVersion",
        "occurredAt",
        "aggregateType",
        "aggregateId",
        "sequence",
        "payload"
      ]
    },
    "DomainProjection": {
      "anyOf": [
        {
          "$ref": "#/$defs/Workspace"
        },
        {
          "$ref": "#/$defs/AccountConnection"
        }
      ]
    },
    "EmptyPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "FailureEnvelope": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/TradeXError"
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "requestId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 1,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "schemaVersion",
        "ok",
        "error"
      ]
    },
    "OpenOrder": {
      "type": "object",
      "properties": {
        "brokerOrderId": {
          "type": "string"
        },
        "filledQuantity": {
          "type": "string"
        },
        "limitPrice": {
          "type": [
            "string",
            "null"
          ]
        },
        "notional": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "type": [
            "string",
            "null"
          ]
        },
        "side": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "brokerOrderId",
        "symbol",
        "side",
        "filledQuantity",
        "status"
      ]
    },
    "OpenWorkspace": {
      "type": "object",
      "properties": {
        "baseCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "PermissionReview": {
      "type": "object",
      "properties": {
        "acknowledged": {
          "type": "boolean"
        },
        "detected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ipAllowListStatus": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "UNVERIFIED"
          ]
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "detected",
        "forbidden",
        "unsupported",
        "acknowledged",
        "ipAllowListStatus"
      ]
    },
    "Position": {
      "type": "object",
      "properties": {
        "averageEntryPrice": {
          "type": [
            "string",
            "null"
          ]
        },
        "marketValue": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "symbol",
        "quantity"
      ]
    },
    "ProviderCatalog": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderDefinition"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "providers"
      ]
    },
    "ProviderDefinition": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "displayName": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderField"
          }
        },
        "forbiddenPermissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "helpText": {
          "type": "string"
        },
        "optionalPermissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "providerId": {
          "type": "string"
        },
        "requiredPermissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "providerId",
        "displayName",
        "environment",
        "available",
        "helpText",
        "fields",
        "requiredPermissions",
        "optionalPermissions",
        "forbiddenPermissions"
      ]
    },
    "ProviderField": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string"
        },
        "helpText": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "inputType": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "maxLength": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "inputType",
        "required",
        "secret",
        "maxLength",
        "helpText",
        "environment"
      ]
    },
    "ProviderSelection": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "providerId",
        "environment"
      ]
    },
    "Remediation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ]
    },
    "ReplyData": {
      "anyOf": [
        {
          "$ref": "#/$defs/Workspace"
        },
        {
          "$ref": "#/$defs/Snapshot"
        },
        {
          "$ref": "#/$defs/RuntimeStatus"
        },
        {
          "$ref": "#/$defs/SubscriptionAck"
        },
        {
          "$ref": "#/$defs/ProviderCatalog"
        },
        {
          "$ref": "#/$defs/ProviderDefinition"
        },
        {
          "$ref": "#/$defs/Accounts"
        },
        {
          "$ref": "#/$defs/AccountConnection"
        },
        {
          "$ref": "#/$defs/PermissionReview"
        }
      ]
    },
    "ResultEnvelope": {
      "anyOf": [
        {
          "$ref": "#/$defs/SuccessEnvelope"
        },
        {
          "$ref": "#/$defs/FailureEnvelope"
        }
      ]
    },
    "RuntimeComponent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "message"
      ]
    },
    "RuntimeStatus": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeComponent"
          }
        },
        "liveExecutionAvailable": {
          "type": "boolean"
        },
        "modelAvailable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "components",
        "modelAvailable",
        "liveExecutionAvailable"
      ]
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "aggregateId": {
          "type": "string",
          "minLength": 1
        },
        "aggregateType": {
          "type": "string",
          "enum": [
            "workspace",
            "account"
          ]
        },
        "lastSequence": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "projection": {
          "$ref": "#/$defs/DomainProjection"
        }
      },
      "additionalProperties": false,
      "required": [
        "aggregateType",
        "aggregateId",
        "projection",
        "lastSequence"
      ]
    },
    "Subscribe": {
      "type": "object",
      "properties": {
        "afterSequence": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "aggregateId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "aggregateType": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "aggregateType",
        "aggregateId",
        "afterSequence"
      ]
    },
    "SubscriptionAck": {
      "type": "object",
      "properties": {
        "afterSequence": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1
        },
        "aggregateType": {
          "type": "string",
          "enum": [
            "workspace",
            "account"
          ]
        },
        "lastSequence": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "replayedCount": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "aggregateType",
        "aggregateId",
        "afterSequence",
        "lastSequence",
        "replayedCount"
      ]
    },
    "SuccessEnvelope": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/ReplyData"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "requestId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 1,
          "minimum": 0
        },
        "stateVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "schemaVersion",
        "ok",
        "data"
      ]
    },
    "TradeXError": {
      "type": "object",
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "remediationActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Remediation"
          }
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "category",
        "code",
        "message",
        "retryable",
        "blocking",
        "remediationActions"
      ]
    },
    "Workspace": {
      "type": "object",
      "properties": {
        "baseCurrency": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "lastOpenedAt": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "storageSchemaVersion": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "name",
        "baseCurrency",
        "path",
        "createdAt",
        "lastOpenedAt",
        "storageSchemaVersion"
      ]
    },
    "WorkspaceQuery": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId"
      ]
    }
  },
  "$id": "https://tradex.local/schema/ipc-v1"
}
