{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IpcSchema",
  "description": "Exported to JSON Schema and TypeScript, and used for renderer runtime validation.",
  "type": "object",
  "properties": {
    "accountMutation": {
      "$ref": "#/$defs/AccountMutation"
    },
    "accountQuery": {
      "$ref": "#/$defs/AccountQuery"
    },
    "aggregate": {
      "$ref": "#/$defs/Aggregate"
    },
    "chatgptLogin": {
      "$ref": "#/$defs/ChatgptLogin"
    },
    "command": {
      "$ref": "#/$defs/CommandEnvelope"
    },
    "completeOnboarding": {
      "$ref": "#/$defs/CompleteOnboarding"
    },
    "configureDeepseek": {
      "$ref": "#/$defs/ConfigureDeepseek"
    },
    "empty": {
      "$ref": "#/$defs/EmptyPayload"
    },
    "event": {
      "$ref": "#/$defs/DomainEvent"
    },
    "gatewayMutation": {
      "$ref": "#/$defs/GatewayMutation"
    },
    "modelQuery": {
      "$ref": "#/$defs/ModelQuery"
    },
    "providerConnect": {
      "$ref": "#/$defs/Connect"
    },
    "providerSelection": {
      "$ref": "#/$defs/ProviderSelection"
    },
    "result": {
      "$ref": "#/$defs/ResultEnvelope"
    },
    "riskQuery": {
      "$ref": "#/$defs/RiskQuery"
    },
    "saveRiskPolicy": {
      "$ref": "#/$defs/SaveRiskPolicy"
    },
    "setDefaultModel": {
      "$ref": "#/$defs/SetDefaultModel"
    },
    "setFallbackPolicy": {
      "$ref": "#/$defs/SetFallbackPolicy"
    },
    "setOnboardingStep": {
      "$ref": "#/$defs/SetOnboardingStep"
    },
    "subscribe": {
      "$ref": "#/$defs/Subscribe"
    },
    "verifyRoute": {
      "$ref": "#/$defs/VerifyRoute"
    },
    "workspaceOpen": {
      "$ref": "#/$defs/OpenWorkspace"
    },
    "workspaceQuery": {
      "$ref": "#/$defs/WorkspaceQuery"
    }
  },
  "required": [
    "gatewayMutation",
    "modelQuery",
    "chatgptLogin",
    "configureDeepseek",
    "verifyRoute",
    "setDefaultModel",
    "setFallbackPolicy",
    "riskQuery",
    "saveRiskPolicy",
    "setOnboardingStep",
    "completeOnboarding",
    "command",
    "result",
    "event",
    "workspaceOpen",
    "aggregate",
    "subscribe",
    "empty",
    "providerSelection",
    "workspaceQuery",
    "accountQuery",
    "accountMutation",
    "providerConnect"
  ],
  "$defs": {
    "AccountConnection": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1
        },
        "connectionState": {
          "$ref": "#/$defs/ConnectionState"
        },
        "createdAt": {
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountData"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "type": "string"
        },
        "health": {
          "$ref": "#/$defs/AccountHealth"
        },
        "label": {
          "type": "string"
        },
        "lastSuccessfulSync": {
          "type": [
            "string",
            "null"
          ]
        },
        "permissions": {
          "$ref": "#/$defs/PermissionReview"
        },
        "providerId": {
          "type": "string"
        },
        "stateVersion": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "connectionId",
        "workspaceId",
        "providerId",
        "environment",
        "label",
        "createdAt",
        "updatedAt",
        "stateVersion",
        "connectionState",
        "health",
        "permissions"
      ]
    },
    "AccountData": {
      "type": "object",
      "properties": {
        "accountType": {
          "type": "string"
        },
        "balances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Balance"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "openOrders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenOrder"
          }
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Position"
          }
        },
        "remoteAccountId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "remoteAccountId",
        "accountType",
        "balances",
        "positions",
        "openOrders",
        "capabilities",
        "limitations"
      ]
    },
    "AccountHealth": {
      "type": "object",
      "properties": {
        "arming": {
          "type": "string"
        },
        "authentication": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        },
        "credential": {
          "type": "string"
        },
        "executionEligibility": {
          "type": "string"
        },
        "privateStream": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "reconciliation": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "connection",
        "authentication",
        "credential",
        "privateStream",
        "reconciliation",
        "executionEligibility",
        "arming",
        "reason"
      ]
    },
    "AccountMutation": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "expectedStateVersion": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "connectionId",
        "expectedStateVersion"
      ]
    },
    "AccountQuery": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "connectionId"
      ]
    },
    "Accounts": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountConnection"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "accounts"
      ]
    },
    "Aggregate": {
      "type": "object",
      "properties": {
        "aggregateId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "aggregateType": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "aggregateType",
        "aggregateId"
      ]
    },
    "Balance": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string"
        },
        "available": {
          "type": "string"
        },
        "inPies": {
          "type": [
            "string",
            "null"
          ]
        },
        "locked": {
          "type": [
            "string",
            "null"
          ]
        },
        "reserved": {
          "type": [
            "string",
            "null"
          ]
        },
        "restrictedAvailable": {
          "type": [
            "string",
            "null"
          ]
        },
        "total": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "asset",
        "available"
      ]
    },
    "ChatgptLogin": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ChatgptLoginAction"
        },
        "expectedStateVersion": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "expectedStateVersion",
        "action"
      ]
    },
    "ChatgptLoginAction": {
      "type": "string",
      "enum": [
        "LOGIN",
        "RELOGIN"
      ]
    },
    "CommandEnvelope": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "payload": true,
        "requestId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 1,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "schemaVersion",
        "command",
        "payload"
      ]
    },
    "CompleteOnboarding": {
      "type": "object",
      "properties": {
        "expectedStateVersion": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "expectedStateVersion"
      ]
    },
    "ConfigureDeepseek": {
      "type": "object",
      "properties": {
        "expectedStateVersion": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "expectedStateVersion"
      ]
    },
    "Connect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "environment": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "providerId": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "test"
            },
            "workspaceId": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "step",
            "workspaceId",
            "providerId",
            "environment",
            "label"
          ]
        },
        {
          "type": "object",
          "properties": {
            "acknowledgeUnverified": {
              "type": "boolean"
            },
            "connectionId": {
              "type": "string"
            },
            "expectedStateVersion": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "confirm"
            },
            "workspaceId": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "step",
            "workspaceId",
            "connectionId",
            "expectedStateVersion",
            "acknowledgeUnverified"
          ]
        }
      ]
    },
    "ConnectionState": {
      "type": "string",
      "enum": [
        "CONNECTING",
        "REVIEW_REQUIRED",
        "CONNECTED",
        "FAILED",
        "DISCONNECTED"
      ]
    },
    "DomainEvent": {
      "type": "object",
      "properties": {
        "aggregateId": {
          "type": "string",
          "minLength": 1
        },
        "aggregateType": {
          "type": "string",
          "enum": [
            "workspace",
            "account",
            "model-gateway",
            "model",
            "risk"
          ]
        },
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "eventType": {
          "type": "string",
          "enum": [
            "workspace.opened",
            "account.health.changed",
            "model.gateway.changed",
            "model.provider.changed",
            "model.provider_attempt.changed",
            "risk.policy.changed"
          ]
        },
        "occurredAt": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/DomainProjection"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 1,
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventType",
        "schemaVersion",
        "occurredAt",
        "aggregateType",
        "aggregateId",
        "sequence",
        "payload"
      ]
    },
    "DomainProjection": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayState"
        },
        {
          "$ref": "#/$defs/ModelState"
        },
        {
          "$ref": "#/$defs/Workspace"
        },
        {
          "$ref": "#/$defs/AccountConnection"
        },
        {
          "$ref": "#/$defs/RiskPolicyState"
        }
      ]
    },
    "EmptyPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "FailureEnvelope": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/TradeXError"
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "requestId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 1,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "schemaVersion",
        "ok",
        "error"
      ]
    },
    "GatewayAction": {
      "type": "string",
      "enum": [
        "LAUNCH",
        "PROBE",
        "RESTART",
        "STOP"
      ]
    },
    "GatewayMutation": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/GatewayAction"
        },
        "expectedStateVersion": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "expectedStateVersion",
        "action"
      ]
    },
    "GatewayState": {
      "type": "object",
      "properties": {
        "desiredRunning": {
          "type": "boolean"
        },
        "discoveredModelCount": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1000,
          "minimum": 0
        },
        "endpoint": {
          "type": "string",
          "const": "http://127.0.0.1:8317"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "installed": {
          "type": "boolean"
        },
        "lastProbeAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelAvailable": {
          "type": "boolean"
        },
        "nextRetryAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "pinnedVersion": {
          "type": "string",
          "const": "7.2.155"
        },
        "restartAttempts": {
          "type": "integer",
          "format": "uint32",
          "maximum": 3,
          "minimum": 0
        },
        "stateVersion": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/GatewayStatus"
        },
        "updatedAt": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "stateVersion",
        "pinnedVersion",
        "endpoint",
        "status",
        "desiredRunning",
        "installed",
        "modelAvailable",
        "discoveredModelCount",
        "restartAttempts",
        "updatedAt"
      ]
    },
    "GatewayStatus": {
      "type": "string",
      "enum": [
        "STOPPED",
        "INSTALLING",
        "STARTING",
        "RUNNING",
        "PORT_CONFLICT",
        "UNAUTHORIZED",
        "BACKOFF",
        "FAILED",
        "STOPPING"
      ]
    },
    "HardSafetyRule": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ]
    },
    "ModelAttempt": {
      "type": "object",
      "properties": {
        "attemptId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "endedAt": {
          "type": "string"
        },
        "errorCategory": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ModelAttemptKind",
          "default": "SETUP"
        },
        "modelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/ModelAttemptOutcome"
        },
        "provider": {
          "$ref": "#/$defs/ModelProvider"
        },
        "quota": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelQuota"
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "type": "string"
        },
        "thinkingType": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThinkingType"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "attemptId",
        "provider",
        "startedAt",
        "endedAt",
        "outcome"
      ]
    },
    "ModelAttemptKind": {
      "type": "string",
      "enum": [
        "SETUP",
        "THREAD"
      ]
    },
    "ModelAttemptOutcome": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "CONFIGURED",
        "CANCELLED",
        "FAILED"
      ]
    },
    "ModelHealth": {
      "type": "string",
      "enum": [
        "NOT_CONFIGURED",
        "UNVERIFIED",
        "VERIFYING",
        "READY",
        "FAILED"
      ]
    },
    "ModelProvider": {
      "type": "string",
      "enum": [
        "CHATGPT",
        "DEEPSEEK"
      ]
    },
    "ModelProviderState": {
      "type": "object",
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastVerifiedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/ModelProvider"
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelRoute"
          },
          "maxItems": 100
        },
        "status": {
          "$ref": "#/$defs/ModelHealth"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "configured",
        "status",
        "routes"
      ]
    },
    "ModelQuery": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaceId"
      ]
    },
    "ModelQuota": {
      "type": "object",
      "properties": {
        "remaining": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "maximum": 1000000000,
          "minimum": 0
        },
        "resetAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryAfterSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "maximum": 86400,
          "minimum": 0
        },
        "window": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ModelRoute": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "provider": {
          "$ref": "#/$defs/ModelProvider"
        },
        "thinkingType": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThinkingType"
            },
            {
              "type": "null"
            }
          ]
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "modelId"
      ]
    },
    "ModelSelection": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "provider": {
          "$ref": "#/$defs/ModelProvider"
        },
        "thinkingType": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThinkingType"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "modelId"
      ]
    },
    "ModelState": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelAttempt"
          },
          "maxItems": 100
        },
        "automaticFallback": {
          "type": "boolean",
          "default": false
        },
        "chatgpt": {
          "$ref": "#/$defs/ModelProviderState"
        },
        "currentRoute": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRoute"
            },
            {
              "type": "null"
            }
          ]
        },
        "deepseek": {
          "$ref": "#/$defs/ModelProviderState"
        },
        "defaultRoute": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelSelection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fallbackPolicyVersion": {
          "type": "integer",
          "format": "uint64",
